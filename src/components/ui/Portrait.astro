---
import { Image } from 'astro:assets';
import rubenCutout from '../../assets/images/ruben-cutout.png';

interface Props {
  /** Tamaño del retrato; `hero` usa `--avatar-hero`. */
  size?: 'hero' | 'md';
  loading?: 'eager' | 'lazy';
}

const { size = 'hero', loading = 'eager' } = Astro.props;
---

<div
  class:list={['portrait', { 'portrait--hero': size === 'hero', 'portrait--md': size === 'md' }]}
>
  <Image
    src={rubenCutout}
    alt="Retrato de Rubén Palomo Viedma"
    widths={[320, 480, 640, 800]}
    sizes={size === 'hero' ? 'var(--avatar-hero)' : 'clamp(5rem, 14vw, 8rem)'}
    loading={loading}
    decoding="async"
    class="portrait__image"
  />
</div>

<style>
  .portrait {
    --portrait-size: var(--avatar-hero);
    flex-shrink: 0;
    width: var(--portrait-size);
  }

  .portrait--md {
    --portrait-size: clamp(5rem, 14vw, 8rem);
  }

  .portrait__image {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
