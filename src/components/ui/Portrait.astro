---
import { Image } from 'astro:assets';
import rubenSource from '../../assets/images/ruben-source.png';

interface Props {
  /** Tamaño del retrato; `hero` usa `--avatar-hero`. */
  size?: 'hero' | 'md';
  loading?: 'eager' | 'lazy';
}

const { size = 'hero', loading = 'eager' } = Astro.props;

/** Fuente cuadrada con círculo interior; escala para excluir marco azul y sparkle (D-014). */
const cropScale = 1.62;
const sourceSize = 560;
---

<div
  class:list={['portrait', { 'portrait--hero': size === 'hero', 'portrait--md': size === 'md' }]}
  style={`--portrait-crop-scale: ${cropScale}`}
>
  <span class="portrait__ring" aria-hidden="true"></span>
  <div class="portrait__frame">
    <Image
      src={rubenSource}
      alt="Retrato de Rubén Palomo Viedma"
      width={sourceSize}
      height={sourceSize}
      loading={loading}
      decoding="async"
      class="portrait__image"
    />
  </div>
</div>

<style>
  .portrait {
    --portrait-size: var(--avatar-hero);
    position: relative;
    flex-shrink: 0;
    width: var(--portrait-size);
    height: var(--portrait-size);
  }

  .portrait--md {
    --portrait-size: clamp(5rem, 14vw, 8rem);
  }

  .portrait__ring {
    position: absolute;
    inset: -4px;
    border-radius: var(--radius-full);
    background: conic-gradient(
      from 200deg,
      var(--color-rpv-copper-300),
      var(--color-rpv-copper-100),
      var(--color-rpv-copper-500),
      var(--color-rpv-copper-200)
    );
    opacity: 0.85;
  }

  .portrait__frame {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-full);
    overflow: hidden;
    border: 3px solid var(--color-rpv-white);
    box-shadow: var(--shadow-glow-copper);
    background: var(--color-background-alt);
  }

  .portrait__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(var(--portrait-crop-scale, 1.62));
  }
</style>
