---
import { Image } from 'astro:assets';
import rubenSource from '../../assets/images/ruben-source.png';

interface Props {
  /** Tamaño del retrato; `hero` usa `--avatar-hero`. */
  size?: 'hero' | 'md';
  loading?: 'eager' | 'lazy';
}

const { size = 'hero', loading = 'eager' } = Astro.props;

/** Fuente cuadrada con círculo interior; escala para excluir marco azul y sparkle (D-014). */
const cropScale = 1.62;
const sourceSize = 560;
---

<div
  class:list={['portrait', { 'portrait--hero': size === 'hero', 'portrait--md': size === 'md' }]}
  style={`--portrait-crop-scale: ${cropScale}`}
>
  <Image
    src={rubenSource}
    alt="Retrato de Rubén Palomo Viedma"
    width={sourceSize}
    height={sourceSize}
    loading={loading}
    decoding="async"
    class="portrait__image"
  />
</div>

<style>
  .portrait {
    --portrait-size: var(--avatar-hero);
    flex-shrink: 0;
    width: var(--portrait-size);
    height: var(--portrait-size);
    border-radius: var(--radius-full);
    border: 3px solid var(--color-accent-subtle);
    overflow: hidden;
    background: var(--color-background-alt);
    box-shadow: var(--shadow-sm);
  }

  .portrait--md {
    --portrait-size: clamp(5rem, 14vw, 8rem);
  }

  .portrait__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(var(--portrait-crop-scale, 1.62));
  }
</style>
