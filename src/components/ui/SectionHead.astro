---
interface Props {
  kicker: string;
  heading: string;
  headingId: string;
  lead?: string;
}

const { kicker, heading, headingId, lead } = Astro.props;
---

<header class="section-head" data-reveal>
  <p class="type-label text-accent section-head__kicker">{kicker}</p>
  <h2 class="type-h2" id={headingId}>{heading}</h2>
  {
    lead && (
      <p class="type-body-lg text-text-secondary section-head__lead">{lead}</p>
    )
  }
</header>

<style>
  .section-head {
    max-width: var(--prose-max);
    margin-bottom: var(--space-10);
    padding-top: var(--space-4);
    position: relative;
  }

  .section-head::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 3rem;
    height: 2px;
    background: linear-gradient(
      90deg,
      var(--color-accent),
      color-mix(in srgb, var(--color-accent) 20%, transparent)
    );
  }

  .section-head__kicker {
    margin: 0 0 var(--space-3);
  }

  .section-head .type-h2 {
    margin: 0;
  }

  .section-head__lead {
    margin: var(--space-4) 0 0;
  }
</style>
