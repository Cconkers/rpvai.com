---
interface Props {
  flip?: boolean;
}

const { flip = false } = Astro.props;
---

<div class:list={['section-transition', { 'section-transition--flip': flip }]} aria-hidden="true">
  <svg
    class="section-transition__svg"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 1440 96"
    preserveAspectRatio="none"
  >
    <path
      d="M0,64 C480,96 960,32 1440,64 L1440,96 L0,96 Z"
      fill="currentColor"
    ></path>
  </svg>
</div>

<style>
  .section-transition {
    position: relative;
    z-index: 2;
    height: clamp(2.5rem, 6vw, 4rem);
    margin-top: calc(clamp(2.5rem, 6vw, 4rem) * -1);
    color: color-mix(in srgb, var(--color-rpv-white) 72%, transparent);
    filter: drop-shadow(0 -1px 0 color-mix(in srgb, var(--color-border) 50%, transparent));
  }

  .section-transition--flip {
    transform: scaleY(-1);
    margin-top: 0;
    margin-bottom: calc(clamp(2.5rem, 6vw, 4rem) * -1);
  }

  .section-transition__svg {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
