---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { previewForSlug } from '../../data/projectPreviews';
import Icon from './Icon.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, year, role, summary, stack, url, slug } = project.data;
const liveUrl = url.startsWith('http') ? url : null;
const caseHref = `/work/${slug}/`;
const previewImage = previewForSlug(slug);
---

{
  liveUrl && (
    <article class="showcase" data-reveal>
      <a
        class="showcase__media"
        href={liveUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${title} — abrir sitio en vivo`}
      >
        <div class="showcase__frame" aria-hidden="true">
          <span class="showcase__frame-bar">
            <span class="showcase__dots"><span></span><span></span><span></span></span>
            <span class="showcase__url">{liveUrl.replace(/^https?:\/\//, '')}</span>
          </span>
          {
            previewImage ? (
              <Image
                src={previewImage}
                alt={`Captura de ${title}`}
                widths={[720, 1080, 1440]}
                sizes="(min-width: 1024px) 58vw, 100vw"
                loading="eager"
                decoding="async"
                class="showcase__shot"
              />
            ) : (
              <div class="showcase__placeholder">{title}</div>
            )
          }
        </div>
        <span class="showcase__overlay type-label">Ver sitio en vivo</span>
      </a>

      <div class="showcase__copy">
        <p class="type-label text-accent">{year} · {role} · En producción</p>
        <h3 class="showcase__title type-h1">{title}</h3>
        <p class="type-body-lg text-text-secondary">{summary}</p>

        {
          stack.length > 0 && (
            <ul class="showcase__stack" role="list">
              {stack.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )
        }

        <div class="showcase__actions">
          <a
            class="btn btn-primary"
            href={liveUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Abrir en Vercel
            <Icon name="external" size={18} />
          </a>
          <a class="btn btn-secondary" href={caseHref}>Leer el caso</a>
        </div>
      </div>
    </article>
  )
}

<style>
  .showcase {
    display: grid;
    gap: var(--space-8);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-10);
  }

  .showcase__media {
    position: relative;
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-lg);
    overflow: hidden;
    outline: none;
    box-shadow: var(--shadow-lg);
    transition:
      transform var(--duration-slow) var(--ease-luxe),
      box-shadow var(--duration-slow) var(--ease-luxe);
  }

  .showcase__frame {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: inherit;
    overflow: hidden;
  }

  .showcase__frame-bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-background-alt);
  }

  .showcase__dots {
    display: inline-flex;
    gap: 0.3rem;
  }

  .showcase__dots span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--radius-full);
    background: var(--color-border-strong);
  }

  .showcase__url {
    font-size: var(--text-small);
    color: var(--color-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .showcase__shot {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top center;
    transition: transform var(--duration-luxe) var(--ease-luxe);
  }

  .showcase__placeholder {
    display: grid;
    place-items: center;
    min-height: 16rem;
    background: var(--color-background-alt);
    font-family: var(--font-display);
    font-size: var(--text-h2);
  }

  .showcase__overlay {
    position: absolute;
    inset: auto var(--space-4) var(--space-4) auto;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-primary) 88%, transparent);
    color: var(--color-text-on-fill);
    opacity: 0;
    transform: translateY(0.5rem);
    transition:
      opacity var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  .showcase__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    max-width: 42rem;
  }

  .showcase__copy .type-label {
    margin: 0;
  }

  .showcase__title {
    margin: 0;
    max-width: 14ch;
  }

  .showcase__copy .type-body-lg {
    margin: 0;
  }

  .showcase__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .showcase__stack li {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    font-family: ui-monospace, 'Cascadia Code', 'Segoe UI Mono', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    background: var(--color-surface);
  }

  .showcase__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .showcase__actions .btn {
    gap: var(--space-2);
  }

  @media (min-width: 1024px) {
    .showcase {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
      gap: var(--space-12);
      align-items: center;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .showcase__media:hover,
    .showcase__media:focus-visible {
      transform: translateY(-4px);
      box-shadow: var(--shadow-xl);
    }

    .showcase__media:hover .showcase__shot,
    .showcase__media:focus-visible .showcase__shot {
      transform: scale(1.02);
    }

    .showcase__media:hover .showcase__overlay,
    .showcase__media:focus-visible .showcase__overlay {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .showcase__media:focus-visible {
    box-shadow: var(--shadow-focus);
  }

  @media (prefers-reduced-motion: reduce) {
    .showcase__media,
    .showcase__shot,
    .showcase__overlay {
      transition: none;
    }
  }
</style>
