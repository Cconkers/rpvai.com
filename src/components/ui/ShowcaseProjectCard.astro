---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { previewForSlug } from '../../data/projectPreviews';
import Icon from './Icon.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, year, role, summary, stack, url, slug } = project.data;
const liveUrl = url.startsWith('http') ? url : null;
const caseHref = `/work/${slug}/`;
const previewImage = previewForSlug(slug);
---

{
  liveUrl && (
    <article class="showcase" data-reveal>
      <a
        class="showcase__media"
        href={liveUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${title} — abrir sitio en vivo`}
      >
        <div class="showcase__frame" aria-hidden="true">
          {
            previewImage ? (
              <Image
                src={previewImage}
                alt={`Captura de ${title}`}
                widths={[720, 1080, 1440]}
                sizes="(min-width: 1024px) 58vw, 100vw"
                loading="eager"
                decoding="async"
                class="showcase__shot"
              />
            ) : (
              <div class="showcase__placeholder">{title}</div>
            )
          }
        </div>
        <span class="showcase__badge">Ver sitio en vivo</span>
      </a>

      <div class="showcase__copy">
        <p class="showcase__meta">{year} · {role} · En producción</p>
        <h3 class="showcase__title">{title}</h3>
        <p class="showcase__summary">{summary}</p>

        {
          stack.length > 0 && (
            <ul class="showcase__stack" role="list">
              {stack.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )
        }

        <div class="showcase__actions">
          <a
            class="btn btn-pill-dark"
            href={liveUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Abrir en Vercel
            <Icon name="external" size={18} />
          </a>
          <a class="btn btn-pill-outline" href={caseHref}>Leer el caso</a>
        </div>
      </div>
    </article>
  )
}

<style>
  .showcase {
    display: grid;
    gap: var(--space-10);
    border-top: 1px solid var(--color-iron);
    padding-top: var(--space-10);
  }

  .showcase__media {
    position: relative;
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: 2rem;
    overflow: hidden;
    outline: none;
    border: 1px solid var(--color-iron);
    transition: border-color var(--duration-base) var(--ease-out);
  }

  .showcase__frame {
    background: var(--color-bone);
    overflow: hidden;
  }

  .showcase__shot {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top center;
  }

  .showcase__placeholder {
    display: grid;
    place-items: center;
    min-height: 16rem;
    background: var(--color-bone);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .showcase__badge {
    position: absolute;
    inset: auto var(--space-4) var(--space-4) auto;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-badge);
    background: color-mix(in srgb, var(--color-obsidian) 82%, transparent);
    color: var(--color-paper-white);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 500;
    letter-spacing: -0.02em;
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-out);
  }

  .showcase__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    max-width: 42rem;
  }

  .showcase__meta {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-charcoal);
  }

  .showcase__title {
    margin: 0;
    max-width: 14ch;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .showcase__summary {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.125rem;
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: var(--color-charcoal);
  }

  .showcase__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .showcase__stack li {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-iron);
    border-radius: var(--radius-badge);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-charcoal);
    background: var(--color-bone);
  }

  .showcase__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .showcase__actions .btn {
    gap: var(--space-2);
  }

  @media (min-width: 1024px) {
    .showcase {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
      gap: var(--space-12);
      align-items: center;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .showcase__media:hover,
    .showcase__media:focus-visible {
      border-color: var(--color-charcoal);
    }

    .showcase__media:hover .showcase__badge,
    .showcase__media:focus-visible .showcase__badge {
      opacity: 1;
    }
  }

  .showcase__media:focus-visible {
    box-shadow: var(--shadow-focus);
  }

  @media (prefers-reduced-motion: reduce) {
    .showcase__badge {
      transition: none;
    }
  }
</style>
