---
import Portrait from '../ui/Portrait.astro';
import { site } from '../../data/site';
---

<section class="hero" data-cinematic-section="hero" aria-labelledby="hero-heading">
  <div class="hero__inner">
    <div class="hero__portrait hero__enter hero__enter--1">
      <Portrait />
    </div>

    <div class="hero__panel">
      <p class="chip hero__enter hero__enter--2">{site.availabilityLabel}</p>

      <p class="hero__name hero__enter hero__enter--3">{site.shortName}</p>

      <h1 id="hero-heading" class="hero__title type-display hero__enter hero__enter--4">
        {site.heroHeadline}
      </h1>

      <p class="hero__support type-body-lg text-text-secondary hero__enter hero__enter--5">
        {site.heroSupport}
      </p>

      <p
        class="hero__tech type-label text-muted hero__enter hero__enter--6"
        aria-label="Stack tecnológico"
      >
        {site.heroTechLine}
      </p>

      <div class="hero__actions hero__enter hero__enter--7">
        <a
          class="btn btn-primary"
          href={site.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          {site.ctaLabel}
        </a>
        <a class="btn btn-secondary" href={site.ctaSecondaryHref}>
          {site.ctaSecondaryLabel}
        </a>
      </div>
    </div>
  </div>

  <div class="hero__scroll" aria-hidden="true">
    <span class="hero__scroll-line"></span>
    <span class="type-label">Scroll</span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100svh;
    min-height: 100dvh;
    padding-block: calc(4rem + var(--space-8)) var(--space-12);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-8);
    align-items: center;
    width: 100%;
    max-width: var(--content-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .hero__portrait {
    display: flex;
    justify-content: center;
  }

  .hero__panel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--color-rpv-white) 72%, transparent);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid color-mix(in srgb, var(--color-border) 65%, transparent);
    box-shadow: var(--shadow-xl);
  }

  .hero__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-secondary);
  }

  .hero__title {
    margin: 0;
    max-width: 14ch;
    background: linear-gradient(
      135deg,
      var(--color-text) 0%,
      var(--color-rpv-copper-800) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__support {
    margin: 0;
    max-width: 42ch;
  }

  .hero__tech {
    margin: 0;
    letter-spacing: 0.12em;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .hero__scroll {
    position: absolute;
    bottom: var(--space-6);
    left: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    transform: translateX(-50%);
    color: var(--color-muted);
    opacity: 0.7;
  }

  .hero__scroll-line {
    width: 1px;
    height: 2.5rem;
    background: linear-gradient(
      180deg,
      var(--color-accent),
      transparent
    );
    animation: hero-scroll-pulse 2s var(--ease-luxe) infinite;
  }

  @keyframes hero-scroll-pulse {
    0%, 100% { transform: scaleY(0.6); opacity: 0.4; }
    50% { transform: scaleY(1); opacity: 1; }
  }

  .hero__enter {
    opacity: 0;
    transform: translateY(1.75rem);
    transition:
      opacity var(--duration-luxe) var(--ease-luxe),
      transform var(--duration-luxe) var(--ease-luxe);
  }

  :global(html.is-ready) .hero__enter--1 { opacity: 1; transform: translateY(0); transition-delay: 0ms; }
  :global(html.is-ready) .hero__enter--2 { opacity: 1; transform: translateY(0); transition-delay: 100ms; }
  :global(html.is-ready) .hero__enter--3 { opacity: 1; transform: translateY(0); transition-delay: 180ms; }
  :global(html.is-ready) .hero__enter--4 { opacity: 1; transform: translateY(0); transition-delay: 260ms; }
  :global(html.is-ready) .hero__enter--5 { opacity: 1; transform: translateY(0); transition-delay: 340ms; }
  :global(html.is-ready) .hero__enter--6 { opacity: 1; transform: translateY(0); transition-delay: 400ms; }
  :global(html.is-ready) .hero__enter--7 { opacity: 1; transform: translateY(0); transition-delay: 480ms; }

  @media (min-width: 768px) {
    .hero__inner {
      grid-template-columns: auto minmax(0, 1fr);
      gap: var(--space-12);
      align-items: center;
    }

    .hero__portrait {
      justify-content: flex-start;
    }

    .hero__panel {
      padding: var(--space-8);
    }

    .hero__title {
      max-width: 13ch;
    }
  }

  @media (min-width: 1024px) {
    .hero__inner {
      gap: var(--space-16);
    }

    .hero__panel {
      padding: var(--space-10);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-line {
      animation: none;
    }

    .hero__enter {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
