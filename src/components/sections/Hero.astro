---
import Portrait from '../ui/Portrait.astro';
import { site } from '../../data/site';
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero__inner">
    <div class="hero__portrait">
      <Portrait />
    </div>

    <div class="hero__content">
      <p class="chip">{site.availabilityLabel}</p>

      <p class="hero__name">{site.shortName}</p>

      <h1 id="hero-heading" class="hero__title type-display">
        {site.heroHeadline}
      </h1>

      <p class="hero__support type-body-lg text-text-secondary">
        {site.heroSupport}
      </p>

      <div class="hero__actions">
        <a
          class="btn btn-primary"
          href={site.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          {site.ctaLabel}
        </a>
        <a class="btn btn-secondary" href={site.ctaSecondaryHref}>
          {site.ctaSecondaryLabel}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: var(--space-10) var(--space-16);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-accent-subtle) 70%, var(--color-background)) 0%,
      var(--color-background) 78%
    );
  }

  .hero::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 1px;
    background: var(--color-border);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-8);
    align-items: center;
    max-width: var(--content-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .hero__portrait {
    display: flex;
    justify-content: center;
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .hero__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-secondary);
  }

  .hero__title {
    margin: 0;
    max-width: 18ch;
  }

  .hero__support {
    margin: 0;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  @media (min-width: 768px) {
    .hero {
      padding-block: var(--space-16) var(--space-20);
    }

    .hero__inner {
      grid-template-columns: auto minmax(0, 1fr);
      gap: var(--space-12);
      align-items: center;
    }

    .hero__portrait {
      justify-content: flex-start;
      padding-inline-end: var(--space-4);
      border-right: 1px solid var(--color-border);
    }

    .hero__title {
      max-width: 16ch;
    }
  }

  @media (min-width: 1024px) {
    .hero__inner {
      gap: var(--space-16);
    }
  }
</style>
