---
import Portrait from '../ui/Portrait.astro';
import { site } from '../../data/site';
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero__inner">
    <div class="hero__portrait">
      <Portrait />
    </div>

    <div class="hero__content">
      <p class="chip">{site.availabilityLabel}</p>

      <h1 id="hero-heading" class="hero__title type-display">
        {site.heroHeadline}
      </h1>

      <p class="hero__support type-body-lg text-text-secondary">
        {site.heroSupport}
      </p>

      <div class="hero__actions">
        <a
          class="btn btn-primary"
          href={site.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          {site.ctaLabel}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-8) var(--space-12);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-8);
    align-items: center;
    max-width: var(--content-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .hero__portrait {
    display: flex;
    justify-content: center;
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .hero__title {
    margin: 0;
    max-width: 16ch;
  }

  .hero__support {
    margin: 0;
  }

  .hero__actions {
    margin-top: var(--space-2);
  }

  @media (min-width: 768px) {
    .hero {
      padding-block: var(--space-12) var(--space-16);
    }

    .hero__inner {
      grid-template-columns: auto 1fr;
      gap: var(--space-10);
    }

    .hero__portrait {
      justify-content: flex-start;
    }

    .hero__title {
      max-width: 14ch;
    }
  }

  @media (min-width: 1024px) {
    .hero__inner {
      gap: var(--space-12);
    }

    .hero__title {
      max-width: 12ch;
    }
  }
</style>
