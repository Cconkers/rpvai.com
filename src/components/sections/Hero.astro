---
import Portrait from '../ui/Portrait.astro';
import { site } from '../../data/site';
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero__media" aria-hidden="true">
    <video
      class="hero__video"
      autoplay
      muted
      loop
      playsinline
      disablepictureinpicture
      preload="auto"
    >
      <source src="/video/hero.mp4" type="video/mp4" />
    </video>
    <div class="hero__wash"></div>
  </div>

  <div class="hero__inner">
    <div class="hero__content">
      <p class="chip hero__enter hero__enter--1">{site.availabilityLabel}</p>

      <h1 id="hero-heading" class="hero__title type-display hero__enter hero__enter--2">
        {site.heroHeadline}
      </h1>

      <p class="hero__support type-body-lg hero__enter hero__enter--3">
        {site.heroSupport}
      </p>

      <p class="hero__tech hero__enter hero__enter--4" aria-label="Stack tecnológico">
        {site.heroTechLine}
      </p>

      <div class="hero__actions hero__enter hero__enter--5">
        <a
          class="btn btn-primary"
          href={site.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          {site.ctaLabel}
        </a>
        <a class="btn btn-secondary" href={site.ctaSecondaryHref}>
          {site.ctaSecondaryLabel}
        </a>
      </div>
    </div>

    <div class="hero__aside hero__enter hero__enter--6">
      <Portrait />
      <p class="hero__name">{site.shortName}</p>
      <p class="hero__role type-small text-muted">{site.tagline}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    min-height: min(100svh, 56rem);
    padding-block: calc(5rem + var(--space-8)) var(--space-16);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  .hero__wash {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        105deg,
        color-mix(in srgb, var(--color-rpv-paper) 94%, transparent) 0%,
        color-mix(in srgb, var(--color-rpv-paper) 88%, transparent) 42%,
        color-mix(in srgb, var(--color-rpv-paper) 72%, transparent) 100%
      );
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-10);
    align-items: end;
    max-width: var(--content-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
    max-width: 38rem;
  }

  .hero__title {
    margin: 0;
    max-width: 11ch;
    color: var(--color-text);
  }

  .hero__support {
    margin: 0;
    max-width: 36ch;
    color: var(--color-text-secondary);
  }

  .hero__tech {
    margin: 0;
    font-family: ui-monospace, 'Cascadia Code', 'Segoe UI Mono', monospace;
    font-size: var(--text-small);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .hero__aside {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-align: center;
  }

  .hero__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
  }

  .hero__role {
    margin: 0;
  }

  .hero__enter {
    opacity: 0;
    transform: translateY(1.25rem);
    transition:
      opacity var(--duration-luxe) var(--ease-luxe),
      transform var(--duration-luxe) var(--ease-luxe);
  }

  :global(html.is-ready) .hero__enter--1 { opacity: 1; transform: none; transition-delay: 0ms; }
  :global(html.is-ready) .hero__enter--2 { opacity: 1; transform: none; transition-delay: 80ms; }
  :global(html.is-ready) .hero__enter--3 { opacity: 1; transform: none; transition-delay: 160ms; }
  :global(html.is-ready) .hero__enter--4 { opacity: 1; transform: none; transition-delay: 220ms; }
  :global(html.is-ready) .hero__enter--5 { opacity: 1; transform: none; transition-delay: 300ms; }
  :global(html.is-ready) .hero__enter--6 { opacity: 1; transform: none; transition-delay: 380ms; }

  @media (min-width: 768px) {
    .hero {
      min-height: 100svh;
      padding-block: calc(5rem + var(--space-12)) var(--space-20);
    }

    .hero__inner {
      grid-template-columns: minmax(0, 1.35fr) auto;
      gap: var(--space-16);
      align-items: center;
    }

    .hero__title {
      max-width: 12ch;
      font-size: clamp(2.75rem, 6.5vw, 5rem);
    }

    .hero__aside {
      align-items: flex-end;
      text-align: right;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__video {
      display: none;
    }

    .hero__wash {
      background: var(--color-background);
    }

    .hero__enter {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
