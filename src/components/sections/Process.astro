---
import SectionHead from '../ui/SectionHead.astro';
import { processHonesty, processIntro, processSteps } from '../../data/offer';
import { site } from '../../data/site';
---

<section class="band band--dark" id="como-trabajo" aria-labelledby="proceso-heading">
  <div class="page-shell">
    <SectionHead
      kicker="03 — Proceso"
      heading="Cómo trabajo"
      headingId="proceso-heading"
      lead={processIntro}
      theme="dark"
      wide
    />

    <ul class="process-tags" role="list" data-reveal-stagger>
      {
        processSteps.map((step) => (
          <li class="process-tag">{step.title}</li>
        ))
      }
    </ul>

    <ol class="process-steps">
      {
        processSteps.map((step, index) => (
          <li class="process-step" data-reveal>
            <span class="process-step__n" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3 class="process-step__title">{step.title}</h3>
            <p class="process-step__body">{step.body}</p>
          </li>
        ))
      }
    </ol>

    <p class="process-note" data-reveal>{processHonesty}</p>

    <a
      class="btn btn-pill-light"
      data-reveal
      href={site.whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      {site.ctaLabel}
    </a>
  </div>
</section>

<style>
  .process-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-10);
    padding: 0;
    list-style: none;
  }

  .process-tag {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-badge);
    background: var(--color-slate-teal);
    color: var(--color-paper-white);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .process-steps {
    display: grid;
    gap: var(--space-8);
    margin: 0 0 var(--space-10);
    padding: 0;
    list-style: none;
    text-align: center;
  }

  .process-step__n {
    display: block;
    margin-bottom: var(--space-3);
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.875rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    color: color-mix(in srgb, var(--color-paper-white) 35%, transparent);
  }

  .process-step__title {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-paper-white);
  }

  .process-step__body {
    margin: 0 auto;
    max-width: 28ch;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: color-mix(in srgb, var(--color-paper-white) 80%, transparent);
  }

  .process-note {
    margin: 0 auto var(--space-8);
    max-width: var(--prose-max);
    padding: var(--space-5) var(--space-6);
    border: 1px solid color-mix(in srgb, var(--color-paper-white) 15%, transparent);
    border-radius: var(--radius-editorial);
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: color-mix(in srgb, var(--color-paper-white) 85%, transparent);
    text-align: center;
  }

  .band--dark .btn-pill-light {
    display: flex;
    margin-inline: auto;
  }

  @media (min-width: 1024px) {
    .process-steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }
</style>
