---
import SectionHead from '../ui/SectionHead.astro';
import { processHonesty, processIntro, processSteps } from '../../data/offer';
import { site } from '../../data/site';
---

<section class="band band--glass section-scene" data-cinematic-section="como-trabajo" id="como-trabajo" aria-labelledby="proceso-heading">
  <div class="page-shell">
    <div class="section-glass">
    <SectionHead
      kicker="03 — Proceso"
      heading="Cómo trabajo"
      headingId="proceso-heading"
      lead={processIntro}
    />

    <ol class="process-steps" data-reveal-stagger>
      {
        processSteps.map((step, index) => (
          <li class="card process-step">
            <span class="process-step__n" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3 class="type-h3">{step.title}</h3>
            <p class="type-body text-text-secondary">{step.body}</p>
          </li>
        ))
      }
    </ol>

    <p class="process-note type-body text-text-secondary" data-reveal>{processHonesty}</p>

    <a
      class="btn btn-primary"
      data-reveal
      href={site.whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      {site.ctaLabel}
    </a>
    </div>
  </div>
</section>

<style>
  .process-steps {
    display: grid;
    gap: var(--space-6);
    margin: 0 0 var(--space-10);
    padding: 0;
    list-style: none;
  }

  .process-step {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-height: 100%;
  }

  .process-step__n {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    color: var(--color-accent);
    line-height: 1;
  }

  .process-note {
    margin: 0 0 var(--space-8);
    max-width: var(--prose-max);
    padding: var(--space-5);
    background: var(--color-surface);
    border-radius: var(--radius-card);
    border-left: 3px solid var(--color-accent);
  }

  @media (min-width: 1024px) {
    .process-steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }
</style>
