---
import SectionHead from '../ui/SectionHead.astro';
import { briefItems, contactLead, emailCtaLabel, mailtoHref, whatsappHref } from '../../data/contact';
import { site } from '../../data/site';
---

<section class="page-shell section-scene" data-cinematic-section="contacto" id="contacto" aria-labelledby="contacto-heading">
  <div class="section-glass">
  <SectionHead
    kicker="05 — Empezar"
    heading="Contacto"
    headingId="contacto-heading"
    lead={contactLead}
  />

  <ol class="brief-grid" data-reveal-stagger>
    {
      briefItems.map((item, index) => (
        <li class="card brief-item">
          <span class="brief-item__n" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <h3 class="type-h3">{item.title}</h3>
          <p class="type-body text-text-secondary">{item.body}</p>
        </li>
      ))
    }
  </ol>

  <div class="contact-actions" data-reveal>
    <a
      class="btn btn-primary"
      href={whatsappHref}
      target="_blank"
      rel="noopener noreferrer"
    >
      {site.ctaLabel}
    </a>
    <a class="btn btn-secondary" href={mailtoHref}>{emailCtaLabel}</a>
  </div>

  <p class="type-small text-muted contact-mail">
    También puedes escribir a
    <a href={mailtoHref}>{site.email}</a>
  </p>
  </div>
</section>

<style>
  .brief-grid {
    display: grid;
    gap: var(--space-6);
    margin: 0 0 var(--space-10);
    padding: 0;
    list-style: none;
  }

  .brief-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .brief-item__n {
    font-family: var(--font-display);
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--color-accent);
  }

  .brief-item .type-h3,
  .brief-item .type-body {
    margin: 0;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .contact-mail {
    margin: var(--space-6) 0 0;
  }

  .contact-mail a {
    color: var(--color-text);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  @media (min-width: 768px) {
    .brief-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
