---
import SectionHead from "../ui/SectionHead.astro";
import {
  briefItems,
  contactLead,
  emailCtaLabel,
  mailtoHref,
  whatsappHref,
} from "../../data/contact";
import { site } from "../../data/site";
---

<section class="page-shell page-shell--white" id="contacto" aria-labelledby="contacto-heading">
  <SectionHead
    kicker="05 — Empezar"
    heading="Contacto"
    headingId="contacto-heading"
    lead={contactLead}
  />

  <ol class="brief-grid" data-reveal-stagger>
    {
      briefItems.map((item, index) => (
        <li class:list={['brief-item', `brief-item--${(index % 4) + 1}`]}>
          <span class="brief-item__n" aria-hidden="true">
            {String(index + 1).padStart(2, "0")}
          </span>
          <h3 class="brief-item__title">{item.title}</h3>
          <p class="brief-item__body">{item.body}</p>
        </li>
      ))
    }
  </ol>

  <div class="contact-actions" data-reveal>
    <a
      class="btn btn-pill-dark"
      href={whatsappHref}
      target="_blank"
      rel="noopener noreferrer"
    >
      {site.ctaLabel}
    </a>
    <a class="btn btn-pill-outline" href={mailtoHref}>{emailCtaLabel}</a>
  </div>

  <p class="type-small text-muted contact-mail">
    También puedes escribir a <a href={mailtoHref}>{site.email}</a>
  </p>
</section>

<style>
  .brief-grid {
    display: grid;
    gap: var(--space-6);
    margin: 0 0 var(--space-10);
    padding: 0;
    list-style: none;
  }

  .brief-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    border-radius: var(--radius-editorial);
    border: 1px solid var(--color-iron);
  }

  .brief-item--1 { background: var(--color-bone); }
  .brief-item--2 { background: var(--color-dusty-sky); }
  .brief-item--3 { background: var(--color-wisteria); }
  .brief-item--4 { background: var(--color-desert-clay); }

  .brief-item__n {
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-charcoal);
    opacity: 0.7;
  }

  .brief-item__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .brief-item__body {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: var(--color-charcoal);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .contact-mail {
    margin: var(--space-6) 0 0;
  }

  .contact-mail a {
    color: var(--color-text);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  @media (min-width: 768px) {
    .brief-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
