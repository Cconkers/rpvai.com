---
import { getCollection } from 'astro:content';
import ProjectCard from '../ui/ProjectCard.astro';
import ShowcaseProjectCard from '../ui/ShowcaseProjectCard.astro';
import SectionHead from '../ui/SectionHead.astro';

const projects = (await getCollection('projects')).sort((a, b) => {
  if (a.data.featured === b.data.featured) return 0;
  return a.data.featured ? -1 : 1;
});

function isShowcase(project: (typeof projects)[number]): boolean {
  return (
    project.data.featured &&
    !project.data.placeholder &&
    project.data.url.startsWith('http')
  );
}
---

<section class="page-shell section-scene" data-cinematic-section="trabajo" id="trabajo" aria-labelledby="trabajo-heading">
  <div class="section-glass">
  <SectionHead
    kicker="01 — Prueba de oficio"
    heading="Trabajo"
    headingId="trabajo-heading"
    lead="Casos reales, no una lista de herramientas. El primero es Burbujas de Luz — pincha para ver el sitio en vivo."
  />

  <ul class="work-grid" role="list" data-reveal-stagger>
    {
      projects.map((project) => (
        <li class:list={[{ 'work-grid__showcase': isShowcase(project) }]}>
          {isShowcase(project) ? (
            <ShowcaseProjectCard project={project} />
          ) : (
            <ProjectCard project={project} />
          )}
        </li>
      ))
    }
  </ul>
  </div>
</section>

<style>
  .work-grid {
    display: grid;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .work-grid > li {
    min-width: 0;
  }

  .work-grid__showcase {
    grid-column: 1 / -1;
  }

  @media (min-width: 768px) {
    .work-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .work-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
