---
import { getCollection } from 'astro:content';
import ProjectCard from '../ui/ProjectCard.astro';
import ShowcaseProjectCard from '../ui/ShowcaseProjectCard.astro';
import SectionHead from '../ui/SectionHead.astro';

const projects = (await getCollection('projects')).sort((a, b) => {
  if (a.data.featured === b.data.featured) return 0;
  return a.data.featured ? -1 : 1;
});

function isShowcase(project: (typeof projects)[number]): boolean {
  return (
    project.data.featured &&
    !project.data.placeholder &&
    project.data.url.startsWith('http')
  );
}

const showcase = projects.find(isShowcase);
const others = projects.filter((p) => !isShowcase(p));
---

<section class="page-shell" id="trabajo" aria-labelledby="trabajo-heading">
  <SectionHead
    kicker="01 — Trabajo"
    heading="Proyectos reales"
    headingId="trabajo-heading"
    lead="Un caso en producción. El resto llegará cuando existan URLs y capturas."
    wide
  />

  {showcase && <ShowcaseProjectCard project={showcase} />}

  {
    others.length > 0 && (
      <ul class="work-grid" role="list" data-reveal-stagger>
        {
          others.map((project) => (
            <li>
              <ProjectCard project={project} />
            </li>
          ))
        }
      </ul>
    )
  }
</section>

<style>
  .work-grid {
    display: grid;
    gap: var(--space-6);
    margin: var(--space-12) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 768px) {
    .work-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
