---
import Icon from '../ui/Icon.astro';
import { site } from '../../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <p class="type-label text-accent">{site.mark}</p>
      <p class="site-footer__name">{site.shortName}</p>
      <p class="type-small text-text-secondary">{site.tagline}</p>
    </div>

    <div class="site-footer__contact">
      <h2 class="type-label">Contacto</h2>
      <ul class="site-footer__list" role="list">
        <li>
          <a class="site-footer__link" href={`mailto:${site.email}`}>
            <Icon name="mail" />
            <span>{site.email}</span>
          </a>
        </li>
        <li>
          <a
            class="btn btn-primary"
            href={site.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            {site.ctaLabel}
          </a>
        </li>
      </ul>
    </div>

    <div class="site-footer__social">
      <h2 class="type-label">Perfiles</h2>
      <ul class="site-footer__list" role="list">
        <li>
          <a
            class="site-footer__link"
            href={site.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="github" />
            <span>GitHub</span>
          </a>
        </li>
        <li>
          <a
            class="site-footer__link"
            href={site.linkedinUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="linkedin" />
            <span>LinkedIn</span>
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="site-footer__bar">
    <p class="type-small text-muted">
      © {year} {site.name}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    background: var(--color-background-alt);
    border-top: 1px solid var(--color-border);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-10);
    max-width: var(--content-max);
    margin-inline: auto;
    padding: var(--space-12) var(--gutter);
  }

  .site-footer__name {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    margin: var(--space-2) 0 var(--space-3);
  }

  .site-footer__list {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    color: var(--color-text-secondary);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .site-footer__link:hover {
    color: var(--color-text);
  }

  .site-footer__bar {
    max-width: var(--content-max);
    margin-inline: auto;
    padding: var(--space-6) var(--gutter);
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .site-footer__inner {
      grid-template-columns: 1.2fr 1fr 1fr;
      padding-block: var(--space-16);
    }
  }
</style>
