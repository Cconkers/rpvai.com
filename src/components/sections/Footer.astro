---
import Icon from '../ui/Icon.astro';
import { site } from '../../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <p class="site-footer__mark type-label">{site.mark}</p>
      <p class="site-footer__name">{site.shortName}</p>
      <p class="site-footer__tagline">{site.tagline}</p>
    </div>

    <div class="site-footer__contact">
      <h2 class="site-footer__heading type-label">Contacto</h2>
      <ul class="site-footer__list" role="list">
        <li>
          <a class="site-footer__link" href={`mailto:${site.email}`}>
            <Icon name="mail" />
            <span>{site.email}</span>
          </a>
        </li>
        <li>
          <a
            class="btn btn-pill-dark"
            href={site.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            {site.ctaLabel}
          </a>
        </li>
      </ul>
    </div>

    <div class="site-footer__social">
      <h2 class="site-footer__heading type-label">Perfiles</h2>
      <ul class="site-footer__list" role="list">
        <li>
          <a
            class="site-footer__link"
            href={site.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="github" />
            <span>GitHub</span>
          </a>
        </li>
        <li>
          <a
            class="site-footer__link"
            href={site.linkedinUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="linkedin" />
            <span>LinkedIn</span>
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="site-footer__bar">
    <p class="site-footer__legal-line">
      © {year} {site.name}
    </p>
    <nav aria-label="Información legal" class="site-footer__legal">
      <a class="site-footer__link" href="/aviso-legal/">Aviso legal</a>
      <a class="site-footer__link" href="/privacidad/">Privacidad</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    background: var(--color-stone);
    border-top: 1px solid var(--color-iron);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-10);
    max-width: var(--content-max);
    margin-inline: auto;
    padding: var(--space-12) var(--gutter);
  }

  .site-footer__mark {
    margin: 0;
    letter-spacing: 0.06em;
    color: var(--color-charcoal);
  }

  .site-footer__name {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: var(--space-2) 0 var(--space-3);
  }

  .site-footer__tagline {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: var(--color-charcoal);
  }

  .site-footer__heading {
    margin: 0;
    letter-spacing: 0.06em;
    color: var(--color-charcoal);
  }

  .site-footer__list {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    overflow-wrap: anywhere;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-charcoal);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .site-footer__link:hover {
    color: var(--color-obsidian);
  }

  .site-footer__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    max-width: var(--content-max);
    margin-inline: auto;
    padding: var(--space-6) var(--gutter);
    border-top: 1px solid color-mix(in srgb, var(--color-charcoal) 12%, transparent);
  }

  .site-footer__legal-line {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-caption);
    letter-spacing: -0.02em;
    color: var(--color-charcoal);
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .site-footer__inner {
      grid-template-columns: 1.2fr 1fr 1fr;
      padding-block: var(--space-16);
    }
  }
</style>
