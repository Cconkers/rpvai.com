---
import Icon from '../ui/Icon.astro';
import SectionHead from '../ui/SectionHead.astro';
import { services } from '../../data/offer';

const pastelClasses = [
  'card-pastel--sky',
  'card-pastel--mint',
  'card-pastel--wisteria',
  'card-pastel--clay',
] as const;
---

<section class="page-shell page-shell--white" id="servicios" aria-labelledby="servicios-heading">
  <SectionHead
    kicker="02 — Oferta"
    heading="Servicios"
    headingId="servicios-heading"
    lead="Desarrollo web por proyecto. La interfaz, las APIs, la IA y los datos que tu producto necesite."
    wide
  />

  <ul class="service-grid" role="list" data-reveal-stagger>
    {
      services.map((service, index) => (
        <li class:list={['card-pastel', pastelClasses[index % pastelClasses.length]]}>
          <span class="card-pastel__index" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <span class="card-pastel__icon">
            <Icon name={service.icon} size={22} />
          </span>
          <h3 class="card-pastel__title">{service.title}</h3>
          <p class="card-pastel__body">{service.body}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .service-grid {
    display: grid;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card-pastel {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    border-radius: var(--radius-editorial);
    border: 1px solid var(--color-iron);
    min-height: 100%;
  }

  .card-pastel--sky { background: var(--color-dusty-sky); }
  .card-pastel--mint { background: var(--color-mist-mint); }
  .card-pastel--wisteria { background: var(--color-wisteria); }
  .card-pastel--clay { background: var(--color-desert-clay); }

  .card-pastel__index {
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-charcoal);
    opacity: 0.7;
  }

  .card-pastel__icon {
    display: inline-flex;
    color: var(--color-charcoal);
  }

  .card-pastel__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .card-pastel__body {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: var(--color-charcoal);
  }

  @media (min-width: 768px) {
    .service-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .service-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .service-grid > li:last-child:nth-child(3n + 1) {
      grid-column: span 1;
    }
  }
</style>
