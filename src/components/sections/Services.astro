---
import Icon from '../ui/Icon.astro';
import SectionHead from '../ui/SectionHead.astro';
import { services } from '../../data/offer';
---

<section class="page-shell section-scene" data-cinematic-section="servicios" id="servicios" aria-labelledby="servicios-heading">
  <div class="section-glass">
  <SectionHead
    kicker="02 — Oferta"
    heading="Servicios"
    headingId="servicios-heading"
    lead="Desarrollo web por proyecto: la interfaz, las APIs, la IA y los datos que tu producto necesite. No vendo packs de landing."
  />

  <ul class="service-grid" role="list" data-reveal-stagger>
    {
      services.map((service, index) => (
        <li class="card">
          <div class="card__meta">
            <span class="card__index" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="card__icon">
              <Icon name={service.icon} size={22} />
            </span>
          </div>
          <h3 class="type-h3">{service.title}</h3>
          <p class="type-body text-text-secondary">{service.body}</p>
        </li>
      ))
    }
  </ul>
  </div>
</section>

<style>
  .service-grid {
    display: grid;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-5);
  }

  .card__index {
    font-family: var(--font-display);
    font-size: var(--text-small);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    color: var(--color-accent);
  }

  .card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--color-accent);
    background: var(--color-accent-subtle);
    border-radius: var(--radius-md);
    transition:
      transform var(--duration-slow) var(--ease-luxe),
      background-color var(--duration-base) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .card:hover .card__icon {
      transform: scale(1.08);
      background: color-mix(in srgb, var(--color-accent-subtle) 60%, var(--color-rpv-copper-200));
    }
  }

  @media (min-width: 768px) {
    .service-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .service-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
