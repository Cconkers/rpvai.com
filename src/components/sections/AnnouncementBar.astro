---
import { site } from '../../data/site';
---

<div class="announce-bar" role="region" aria-label="Aviso">
  <p class="announce-bar__text">
    {site.availabilityLabel} · Brief gratuito y propuesta en 48 horas
  </p>
</div>

<style>
  .announce-bar {
    position: relative;
    z-index: 60;
    background: var(--color-obsidian);
    color: var(--color-paper-white);
    text-align: center;
    padding: var(--space-2) var(--gutter);
  }

  .announce-bar__text {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
</style>
