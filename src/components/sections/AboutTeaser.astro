---
import Portrait from '../ui/Portrait.astro';
import SectionHead from '../ui/SectionHead.astro';
import { about } from '../../data/about';
---

<section class="band band--alt" id="sobre-mi" aria-labelledby="sobre-mi-heading">
  <div class="page-shell">
    <SectionHead
      kicker="04 — Persona"
      heading="Sobre mí"
      headingId="sobre-mi-heading"
      lead={about.teaserLead}
    />

    <div class="about-teaser" data-reveal>
      <div class="about-teaser__portrait">
        <Portrait size="md" loading="lazy" />
      </div>
      <div class="about-teaser__copy">
        <p class="about-teaser__body">{about.teaserBody}</p>
        <a class="btn btn-pill-dark" href="/about">{about.moreLabel}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .about-teaser {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  .about-teaser__portrait {
    border-radius: 2rem;
    border: 1px solid var(--color-iron);
    overflow: hidden;
    width: fit-content;
  }

  .about-teaser__portrait :global(img) {
    display: block;
  }

  .about-teaser__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
  }

  .about-teaser__body {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.125rem;
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: var(--color-charcoal);
    max-width: var(--prose-max);
  }

  @media (min-width: 768px) {
    .about-teaser {
      grid-template-columns: auto minmax(0, 1fr);
      gap: var(--space-12);
    }
  }
</style>
