---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { previewForSlug } from '../../data/projectPreviews';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.placeholder);
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, year, role, stack, url, summary, slug } = project.data;
const liveUrl = url.startsWith('http') ? url : null;
const previewImage = previewForSlug(slug);
---

<BaseLayout title={`${title} — ${site.shortName}`} description={summary} ogType="article">
  <article class="page-shell case">
    <p class="type-label text-accent">{year} · {role}</p>
    <h1 class="type-h1">{title}</h1>

    {
      stack.length > 0 && (
        <ul class="case__stack" role="list">
          {stack.map((item) => (
            <li class="case__tag type-small">{item}</li>
          ))}
        </ul>
      )
    }

    <div class="prose">
      <Content />
    </div>

    <div class="case__shots" aria-label="Capturas del proyecto">
      <p class="type-label text-accent">Capturas</p>
      {
        previewImage ? (
          <figure class="case__figure">
            <Image
              src={previewImage}
              alt={`Captura del hero de ${title}`}
              widths={[640, 960, 1280]}
              sizes="(min-width: 1024px) 960px, 100vw"
              loading="lazy"
              decoding="async"
              class="case__shot"
            />
            <figcaption class="type-small text-muted">
              Hero en producción — {liveUrl?.replace(/^https?:\/\//, '')}
            </figcaption>
          </figure>
        ) : (
          <p class="type-body text-text-secondary">
            Pendientes de producción o staging. No se usan mockups de stock.
          </p>
        )
      }
    </div>

    <div class="case__actions">
      {
        liveUrl && (
          <a class="btn btn-secondary" href={liveUrl} target="_blank" rel="noopener noreferrer">
            Ver el sitio
          </a>
        )
      }
      <a
        class="btn btn-primary"
        href={site.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        {site.ctaLabel}
      </a>
      <a class="btn btn-secondary" href="/#trabajo">
        Volver al trabajo
      </a>
    </div>
  </article>
</BaseLayout>

<style>
  .case .type-label {
    margin: 0;
  }

  .case .type-h1 {
    margin-top: var(--space-3);
    max-width: 18ch;
  }

  .case__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-10);
    padding: 0;
    list-style: none;
  }

  .case__tag {
    margin: 0;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-text-secondary);
  }

  .case__shots {
    margin: var(--space-12) 0;
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .case__figure {
    margin: var(--space-4) 0 0;
  }

  .case__shot {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .case__figure figcaption {
    margin-top: var(--space-3);
  }

  .case__shots .type-label {
    margin-bottom: var(--space-3);
  }

  .case__shots .type-body {
    margin: 0;
  }

  .case__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
