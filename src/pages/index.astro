---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import { site } from '../data/site';
---

<BaseLayout
  title={`${site.shortName} — ${site.tagline}`}
  description={site.homeDescription}
>
  <Hero />

  <section class="page-shell" id="trabajo" aria-labelledby="trabajo-heading">
    <h2 class="type-h2" id="trabajo-heading">Trabajo</h2>
    <p class="type-body text-text-secondary">
      El listado de proyectos llega en SPEC-005.
    </p>
  </section>

  <section class="page-shell" id="servicios" aria-labelledby="servicios-heading">
    <h2 class="type-h2" id="servicios-heading">Servicios</h2>
    <p class="type-body text-text-secondary">
      Las líneas de oferta llegan en SPEC-004.
    </p>
  </section>

  <section class="page-shell" id="contacto" aria-labelledby="contacto-heading">
    <h2 class="type-h2" id="contacto-heading">Contacto</h2>
    <p class="type-body text-text-secondary">
      El brief y el detalle de contacto llegan en SPEC-007. Mientras tanto, usa el
      WhatsApp o el email del pie.
    </p>
  </section>
</BaseLayout>
