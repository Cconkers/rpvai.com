---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Process from '../components/sections/Process.astro';
import Services from '../components/sections/Services.astro';
import Work from '../components/sections/Work.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import { site } from '../data/site';
---

<BaseLayout
  title={`${site.shortName} — ${site.tagline}`}
  description={site.homeDescription}
>
  <Hero />
  <Work />
  <Services />
  <Process />

  <section class="page-shell" id="contacto" aria-labelledby="contacto-heading">
    <SectionHead
      kicker="04 — Empezar"
      heading="Contacto"
      headingId="contacto-heading"
      lead="Cuéntame el negocio, el objetivo y el plazo. Te devuelvo una propuesta en 48 horas."
    />
    <div class="contact-row">
      <a
        class="btn btn-primary"
        href={site.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        {site.ctaLabel}
      </a>
      <a class="btn btn-secondary" href={`mailto:${site.email}`}>
        Escribir un email
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
